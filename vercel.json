{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sup/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.lemondeaime.com https://lemondeaime.com https://ai-x-me.com https://www.ai-x-me.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/accessibilite",
      "destination": "/studio/index.html"
    },
    {
      "source": "/accessibilite/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/buro",
      "destination": "/studio/index.html"
    },
    {
      "source": "/buro/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/docs",
      "destination": "/studio/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/image",
      "destination": "/studio/index.html"
    },
    {
      "source": "/image/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/stitchlab",
      "destination": "/studio/index.html"
    },
    {
      "source": "/stitchlab/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/web",
      "destination": "/studio/index.html"
    },
    {
      "source": "/web/",
      "destination": "/studio/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/zero",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/zero/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/monde",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/monde/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/monde/:path*",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/monde/:path*/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/site",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/site/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/site/:path*",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/site/:path*/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/socle",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/socle/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/socle/:path*",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/socle/:path*/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/orb/naissance",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/orb/naissance/",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/orb/naissance/:path*",
      "destination": "/aime/",
      "permanent": false
    },
    {
      "source": "/lab/orb/naissance/:path*/",
      "destination": "/aime/",
      "permanent": false
    }
  ]
}
