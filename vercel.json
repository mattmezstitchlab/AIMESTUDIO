{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sup/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(regie|maitre|maitre/attente|atlas)(/|/index|/index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/etude/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/atlas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.lemondeaime.com https://lemondeaime.com https://ai-x-me.com https://www.ai-x-me.com"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://aimestudio.vercel.app; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' data: blob:; frame-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/travaux",
      "destination": "/api/travaux"
    },
    {
      "source": "/travaux/",
      "destination": "/api/travaux"
    },
    {
      "source": "/travaux/:p",
      "destination": "/api/travaux?p=:p"
    },
    {
      "source": "/travaux/:p/",
      "destination": "/api/travaux?p=:p"
    },
    {
      "source": "/api/auth/:chemin*",
      "destination": "/api/comptes?__chemin=:chemin*"
    },
    {
      "source": "/accessibilite",
      "destination": "/studio/"
    },
    {
      "source": "/accessibilite/",
      "destination": "/studio/"
    },
    {
      "source": "/buro",
      "destination": "/studio/"
    },
    {
      "source": "/buro/",
      "destination": "/studio/"
    },
    {
      "source": "/docs",
      "destination": "/studio/"
    },
    {
      "source": "/docs/",
      "destination": "/studio/"
    },
    {
      "source": "/image",
      "destination": "/studio/"
    },
    {
      "source": "/image/",
      "destination": "/studio/"
    },
    {
      "source": "/stitchlab",
      "destination": "/studio/"
    },
    {
      "source": "/stitchlab/",
      "destination": "/studio/"
    },
    {
      "source": "/web",
      "destination": "/studio/"
    },
    {
      "source": "/web/",
      "destination": "/studio/"
    },
    {
      "source": "/projets",
      "destination": "/compte/"
    },
    {
      "source": "/projets/",
      "destination": "/compte/"
    }
  ],
  "redirects": [
