{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sup/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/migrate.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__p=:path*"
    }
  ]
}
